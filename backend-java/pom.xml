<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.kntap.raykookie</groupId>
    <artifactId>raykookie-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Raykookie Backend (pai)</name>
    <description>Backend Java modular (Clean Architecture) da Raykookie.</description>

    <!-- Cada tarefa seguinte acrescenta o seu módulo aqui. -->
    <modules>
        <module>platform/kernel</module>
        <module>platform/testing</module>
        <module>platform/persistence</module>
        <module>platform/web</module>
        <module>platform/ratelimit</module>
        <module>platform/security</module>
        <module>platform/observability</module>
        <module>platform/scheduling</module>
        <module>modules/identity</module>
        <module>modules/customers</module>
        <module>modules/notifications</module>
        <module>modules/catalog</module>
        <module>modules/purchasing</module>
        <module>app</module>
        <module>contract-tests</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versões estáveis mais recentes no Maven Central em 2026-10-08 (respeitam os mínimos do plano). -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <jacoco.version>0.8.15</jacoco.version>
        <archunit.version>1.5.1</archunit.version>
        <javaparser.version>3.28.2</javaparser.version>
        <wiremock.version>3.13.2</wiremock.version>
        <rest-assured.version>6.0.1</rest-assured.version>
        <jqwik.version>1.10.1</jqwik.version>
        <pitest.version>1.30.0</pitest.version>
        <checkstyle.version>14.3.0</checkstyle.version>

        <!-- Plugins do Maven. -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>

        <!-- Cobertura mínima de linhas do sistema inteiro (agregado de todos os módulos). -->
        <coverage.aggregate.minimum>0.85</coverage.aggregate.minimum>

        <!--
            Linha de comando da JVM dos testes. O JaCoCo preenche argLine na fase initialize; o vazio
            aqui só evita "@{argLine}" literal quando o JaCoCo não roda. Módulos que usam Mockito
            definem mockito.javaagent como -javaagent:${org.mockito:mockito-core:jar} (sem o aviso
            de agente carregado dinamicamente no JDK 26).
        -->
        <argLine></argLine>
        <mockito.javaagent></mockito.javaagent>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <!-- Versão "standalone": traz Jetty e Jackson próprios, sem colidir com os do Spring Boot 4. -->
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-kernel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-testing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-ratelimit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-scheduling</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-purchasing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-notifications</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.kntap.raykookie</groupId>
                <artifactId>raykookie-customers</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine} ${mockito.javaagent}</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine} ${mockito.javaagent}</argLine>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven-install-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Estilo: quebra o build já na fase validate (só código de produção; os testes ficam com o CodeStyleTest). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>warning</violationSeverity>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
                Cobertura: o agente grava target/jacoco.exec em todo módulo (surefire e failsafe). A verificação
                agregada (85% das linhas do sistema inteiro) roda no app, que é construído por último. Os
                mínimos de 95% de payments, refunds e orders entram nos poms desses módulos.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Teste de mutação: ./mvnw -f backend-java/pom.xml -Pmutation verify -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>br.com.kntap.raykookie.kernel.*</param>
                                <param>br.com.kntap.raykookie.payments.domain.*</param>
                                <param>br.com.kntap.raykookie.refunds.domain.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>br.com.kntap.raykookie.*</param>
                            </targetTests>
                            <!-- O argLine do surefire traz o agente do JaCoCo; aqui só o agente do Mockito, quando houver. -->
                            <parseSurefireArgLine>false</parseSurefireArgLine>
                            <argLine>${mockito.javaagent}</argLine>
                            <mutationThreshold>80</mutationThreshold>
                            <!--
                                Módulos sem classes-alvo (hoje, todos) não têm o que mutar; isso não é falha.
                                Onde há classes-alvo, o limite de 80% vale normalmente.
                            -->
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <timestampedReports>false</timestampedReports>
                        </configuration>
                        <executions>
                            <execution>
                                <id>mutation-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
