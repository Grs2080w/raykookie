<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.kntap.raykookie</groupId>
        <artifactId>raykookie-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>raykookie-persistence</artifactId>
    <name>Raykookie Persistence</name>
    <description>
        Banco de dados: pool Hikari com tempos limite, Flyway (migrations reais de produção e V22+ da plataforma)
        e a guarda do esquema de produção (Tarefa 2.2).
    </description>

    <properties>
        <!-- O Spring de teste inicializa o Mockito (do spring-boot-starter-test); como agente, sem aviso no JDK 26. -->
        <mockito.javaagent>-javaagent:${org.mockito:mockito-core:jar}</mockito.javaagent>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-kernel</artifactId>
        </dependency>
        <!-- Hikari, JdbcClient e transações. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Boot 4: a autoconfiguração do Flyway vive num módulo próprio; o suporte ao Postgres é separado. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- Colunas JSON/JSONB lidas como árvore JSON (NodeRows). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <!-- @Validated nas propriedades do banco. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Os *IT rodam contra o Postgres do Testcontainers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Publica o caminho de cada dependência como propriedade (usado pelo -javaagent do Mockito). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
