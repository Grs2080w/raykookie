{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POST /api/orders/{id}/pagamento",
  "type": "object",
  "properties": {
    "url": { "type": "string", "pattern": "/pagar/[A-Za-z0-9_-]{43}$" },
    "amount": { "type": "number" }
  },
  "required": ["url", "amount"],
  "additionalProperties": false
}
