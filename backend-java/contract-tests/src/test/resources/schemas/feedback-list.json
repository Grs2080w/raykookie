{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/feedback",
  "type": "object",
  "properties": {
    "list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" }, "rating": { "type": "integer" }, "message": { "type": "string" },
          "created_at": { "type": "string" }, "customer_name": { "type": "string" },
          "customer_email": { "type": "string" }, "photos": { "type": "integer" }
        },
        "required": ["id", "rating", "message", "created_at", "customer_name", "customer_email", "photos"],
        "additionalProperties": false
      }
    }
  },
  "required": ["list"],
  "additionalProperties": false
}
