{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/payment-config",
  "type": "object",
  "properties": {
    "cardEnabled": {
      "type": "boolean"
    },
    "publicKey": {
      "type": [
        "string",
        "null"
      ]
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "credit_card",
              "debit_card",
              "prepaid_card"
            ]
          },
          "logo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "logo"
        ],
        "additionalProperties": false
      }
    },
    "statusScreenBrick": {
      "type": "boolean"
    }
  },
  "required": [
    "cardEnabled",
    "publicKey",
    "brands",
    "statusScreenBrick"
  ],
  "additionalProperties": false
}
