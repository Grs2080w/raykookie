{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/fixed-costs",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "user_id": {
        "type": "integer"
      },
      "category_id": {
        "type": [
          "integer",
          "null"
        ]
      },
      "name": {
        "type": "string"
      },
      "kind": {
        "enum": [
          "fixed",
          "variable"
        ]
      },
      "amount": {
        "type": "number"
      }
    },
    "required": [
      "id",
      "user_id",
      "category_id",
      "name",
      "kind",
      "amount"
    ],
    "additionalProperties": false
  }
}
