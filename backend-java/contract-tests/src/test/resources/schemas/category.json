{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "POST/PATCH /api/categories",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "user_id": {
      "type": "integer"
    },
    "kind": {
      "enum": [
        "ingredient",
        "recipe",
        "expense"
      ]
    },
    "name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "user_id",
    "kind",
    "name",
    "icon",
    "color"
  ],
  "additionalProperties": false
}
