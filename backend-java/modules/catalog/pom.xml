<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.kntap.raykookie</groupId>
        <artifactId>raykookie-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>raykookie-catalog</artifactId>
    <name>Raykookie Catalog</name>
    <description>Catálogo da dona: ingredientes, receitas e preço, fotos, categorias, gastos fixos, ajustes e alertas de preço (Tarefa 4.4).</description>

    <properties>
        <mockito.javaagent>-javaagent:${org.mockito:mockito-core:jar}</mockito.javaagent>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-notifications</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-security</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-web</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-persistence</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Os vetores de paridade vivem em backend-java/rules-vectors e entram no classpath dos testes. -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}/rules-vectors</directory>
                <targetPath>rules-vectors</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
