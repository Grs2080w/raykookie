<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.kntap.raykookie</groupId>
        <artifactId>raykookie-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>raykookie-payments</artifactId>
    <name>Raykookie Payments</name>
    <description>Pagamentos: Mercado Pago, Pix, cartão, link de pagamento e webhook</description>

    <properties>
        <mockito.javaagent>-javaagent:${org.mockito:mockito-core:jar}</mockito.javaagent>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-orders</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-customers</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-notifications</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-security</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-web</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-ratelimit</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-scheduling</artifactId>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-observability</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.kntap.raykookie</groupId>
            <artifactId>raykookie-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>dependency-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- T11: este módulo mexe com dinheiro; seus próprios testes cobrem pelo menos 95% das linhas. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>coverage-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
