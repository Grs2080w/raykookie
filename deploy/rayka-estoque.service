[Unit]
Description=Rayka Estoque (Next.js) - estoque, receitas e precificacao
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=g_snts
Group=g_snts
WorkingDirectory=/home/g_snts/works/rayka-estoque
EnvironmentFile=/home/g_snts/works/rayka-estoque/.env
Environment=NODE_ENV=production
Environment=PORT=10005
ExecStart=/home/g_snts/.nvm/versions/node/v22.21.1/bin/node node_modules/next/dist/bin/next start -p 10005 -H 0.0.0.0
Restart=always
RestartSec=3
# endurecimento basico
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
