[Unit]
Description=Rayka - API + site + loja + painel (um processo, uma porta)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=g_snts
Group=g_snts
WorkingDirectory=/home/g_snts/works/rayka-estoque/backend
EnvironmentFile=/home/g_snts/works/rayka-estoque/backend/.env
Environment=NODE_ENV=production
Environment=PORT=10005
Environment=FRONTEND_DIR=/home/g_snts/works/rayka-estoque/frontend
Environment=DOWNLOADS_DIR=/home/g_snts/works/rayka-estoque/downloads
ExecStart=/home/g_snts/.nvm/versions/node/v22.21.1/bin/node server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
