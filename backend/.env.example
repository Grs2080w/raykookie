DATABASE_URL=postgres://rayka:SENHA@localhost:5432/rayka_estoque
NODE_ENV=production
COOKIE_SECURE=true                 # true em produção (https)
SITE_URL=https://raykookie.kntap.com.br   # endereço público: redirects (Google), links e og:image
PORT=10005                         # porta única (API + site)
BACKEND_URL=http://127.0.0.1:10005 # o frontend chama a API neste mesmo processo
SHOP_OWNER=rayka                   # usuário do painel que recebe os pedidos da loja
# Login com Google (opcional). Cadastre no Google a URI de redirecionamento:
#   {SITE_URL}/api/cliente/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pix pelo Mercado Pago. O webhook (configure no painel do MP, evento "Pagamentos") fica em
#   {SITE_URL}/api/webhooks/mercadopago   e o pedido só vira "pago" quando o MP avisa que aprovou.
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=                 # "chave secreta" da assinatura do webhook
JOBS_SECRET=                       # segredo das tarefas periódicas (refazer devoluções, conferir pagamentos). Gere com: openssl rand -hex 24
GOOGLE_SITE_VERIFICATION=          # opcional: token da meta do Search Console (verificação do domínio)
PIX_EXPIRES_MINUTES=60             # validade do código Pix (o Mercado Pago aceita de 30 minutos a 30 dias; mínimo aqui: 31)
# E-mail usado como "pagador" nos Pix do link de pagamento (pedido registrado à mão). Padrão: pagamentos@<domínio do SITE_URL>
PAY_LINK_PAYER_EMAIL=
# Push de novos pedidos para o app de gestão (Firebase). Caminho do JSON da conta de serviço;
# vazio = push desligado. Guarde o arquivo fora do projeto (chmod 600).
FIREBASE_SERVICE_ACCOUNT_PATH=
